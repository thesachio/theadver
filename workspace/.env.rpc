# =============================================================================
# RPC ENDPOINTS — PUBLIC / NO-KEY (Whitehat Adversarial Local Fork)
# =============================================================================
# File ini dibaca oleh subagent Fase 3 untuk `--fork-url` / `fork RPC`.
# SEMUA endpoint di bawah sudah diverifikasi hidup (lihat STATUS-VERIFIKASI.md).
#
# ATURAN KERAS (workspace/AGENTS.md Pasal 1.1):
#   - Hanya untuk LOCAL READ-ONLY FORK. DILARANG `--broadcast`, `cast send`,
#     atau transaksi apa pun yang menyentuh state jaringan publik.
#   - Endpoint publik = rate-limited, tanpa SLA, bisa berubah/mati sewaktu-waktu.
#   - JANGAN pernah menaruh private key yang menyimpan dana nyata di proyek
#     yang memakai endpoint publik ini.
#
# Format: satu baris per rantai, di-source oleh shell atau dibaca via env.
# =============================================================================

# --- PARADIGMA A: EVM (chainId terverifikasi) -------------------------------
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com                    # 0x1
RPC_ARBITRUM=https://arbitrum-one-rpc.publicnode.com                # 0xa4b1
RPC_OPTIMISM=https://optimism-rpc.publicnode.com                    # 0xa
RPC_BASE=https://base-rpc.publicnode.com                            # 0x2105
RPC_POLYGON=https://polygon-bor-rpc.publicnode.com                  # 0x89
RPC_BSC=https://bsc-rpc.publicnode.com                              # 0x38
RPC_AVALANCHE=https://avalanche-c-chain-rpc.publicnode.com          # 0xa86a
RPC_GNOSIS=https://gnosis-rpc.publicnode.com                        # 0x64

# Testnet (untuk uji tanpa risiko)
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com             # 0xaa36a7

# --- PARADIGMA A: Tron TVM ------------------------------------------------
# Catatan: TRON pakai 6 desimal (1 TRX = 10^6 SUN), bukan 18.
RPC_TRON_JSONRPC=https://api.trongrid.io/jsonrpc                    # 0x2b6653dc
RPC_TRON_HTTP=https://api.trongrid.io

# --- PARADIGMA A: Solana SVM ----------------------------------------------
# getHealth -> "ok" terverifikasi. Rate limit ketat, fork historis terbatas.
RPC_SOLANA=https://api.mainnet-beta.solana.com   # fallback publik; ber-kunci di .env.rpc.secret

# --- PARADIGMA B: Sui / Aptos Move ----------------------------------------
# Status: Sui public JSON-RPC SUDAH DEPRECATED (pindah ke gRPC).
# `sui move test` TIDAK butuh RPC — cukup CLI lokal.
# Untuk fork Sui, perlu gRPC endpoint sendiri; isi manual bila tersedia.
RPC_SUI_GRPC=
RPC_SUI_JSONRPC_DEPRECATED=https://fullnode.mainnet.sui.io

# Aptos REST API terverifikasi hidup (chain_id=1)
RPC_APTOS_REST=https://fullnode.mainnet.aptoslabs.com/v1

# --- PARADIGMA C: TON Async ----------------------------------------------
# toncenter v2 getMasterchainInfo -> ok:true terverifikasi.
RPC_TON_CENTER=https://toncenter.com/api/v2
RPC_TON_INDEXER=https://toncenter.com/api/v3

# --- NEAR (JSON-RPC) --------------------------------------------------------
# Endpoint ber-kredensial disimpan di .env.rpc.secret (LOCAL VPS ONLY, di-ignore git).
# Muat otomatis oleh rpc-env.sh. Bila file tidak ada, RPC_NEAR kosong.
: "${RPC_NEAR:=}"
: "${RPC_NEAR_RATE_LIMIT:=15}"

# --- Free tier tambahan (verifikasi 2026-11-03, lihat rpc-free-tier.md) ------
# Semua no-key. Slug publicnode untuk rantai di bawah TIDAK ADA (404/503),
# jadi memakai hostname resmi provider. Jangan ganti tanpa uji eth_chainId.
RPC_LINEA=https://linea-rpc.publicnode.com                  # 59144
RPC_ZKSYNC=https://mainnet.era.zksync.io                    # 324
RPC_SCROLL=https://scroll-rpc.publicnode.com                # 534352
RPC_UNICHAIN=https://unichain-rpc.publicnode.com            # 130
RPC_INK=https://ink-rpc.publicnode.com                      # 57073
RPC_SONEIUM=https://soneium-rpc.publicnode.com              # 1868
RPC_MANTLE=https://mantle-rpc.publicnode.com                # 5000
RPC_CELO=https://celo-rpc.publicnode.com                    # 42220
RPC_WORLD=https://worldchain-mainnet.g.alchemy.com/public   # 480
RPC_BLAST=https://rpc.blast.io                              # 81457
RPC_LISK=https://rpc.api.lisk.com                            # 1135
RPC_MODE=https://mainnet.mode.network                        # 34443
RPC_ZORA=https://rpc.zora.energy                             # 7777777
RPC_HYPERLIQUID=https://rpc.hyperliquid.xyz/evm              # 999
# CATATAN: eth_getLogs historis DITOLAK publicnode (butuh token archive).
#           eth_call revert "0x" BUKAN bukti selector absen.

# =============================================================================
# CARA PAKAI
# =============================================================================
# Foundry fork (LOCAL, tanpa broadcast):
#   forge test -j 1 --fork-url $RPC_ETHEREUM
#
# Anvil fork (LOCAL):
#   anvil --fork-url $RPC_ETHEREUM --port 8545
#
# Cast read-only:
#   cast call <addr> "totalSupply()(uint256)" --rpc-url $RPC_ETHEREUM
#
# Load ke shell:
#   set -a; source .env.rpc; set +a
# =============================================================================
